{
  "$ref": "#/definitions/ControlRunControlResponse",
  "definitions": {
    "ControlRunControlResponse": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean",
          "description": "Whether the control was accepted."
        },
        "status": {
          "type": "string",
          "enum": [
            "applied",
            "queued",
            "rejected",
            "unsupported"
          ],
          "default": "queued",
          "description": "Outcome: applied immediately, queued, rejected, or unsupported for this run."
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "description": "Run the control was applied to."
        },
        "cascadeRunIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ControlRunControlResponse/properties/runId"
          },
          "default": [],
          "description": "Active Claudexor Delegate descendants included in this cancellation."
        },
        "message": {
          "type": "string",
          "description": "Human-readable detail."
        },
        "deferredMessage": {
          "type": "object",
          "properties": {
            "draftId": {
              "$ref": "#/definitions/ControlRunControlResponse/properties/runId"
            },
            "revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "state": {
              "type": "string",
              "enum": [
                "waiting",
                "held",
                "dispatched",
                "cleared"
              ]
            },
            "predecessorJobId": {
              "$ref": "#/definitions/ControlRunControlResponse/properties/runId"
            },
            "predecessorRunId": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ControlRunControlResponse/properties/runId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Non-empty identifier string."
            },
            "predecessorResult": {
              "type": "string",
              "description": "Existing addressed run-detail/result path; no duplicate result store."
            },
            "hold": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "predecessor_failed",
                        "predecessor_cancelled",
                        "predecessor_interrupted",
                        "predecessor_needs_input",
                        "predecessor_incomplete",
                        "predecessor_facts_unavailable",
                        "predecessor_work_unverified",
                        "predecessor_checks_failed",
                        "predecessor_review_blocked",
                        "predecessor_output_unavailable",
                        "settlement_unknown",
                        "stop_requested",
                        "shutdown",
                        "restart_requires_controller",
                        "partition_retired",
                        "admission_refused"
                      ]
                    },
                    "problem": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "description": "Human-readable refusal message."
                        },
                        "code": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "default": null,
                          "description": "Machine-readable refusal code carried from the throwing gate; null when the failure had no typed code."
                        },
                        "retryable": {
                          "type": "boolean",
                          "default": true,
                          "description": "True when retry can replay this turn (a job was recorded before the failure); false when no job exists to replay."
                        },
                        "required_actions": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512
                          },
                          "maxItems": 16,
                          "default": [],
                          "description": "Bounded user actions that may make an exact retry succeed."
                        },
                        "context": {
                          "type": "object",
                          "additionalProperties": {},
                          "default": {},
                          "description": "Bounded typed recovery context; never arbitrary provider or environment output."
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": false,
                      "description": "Typed, sanitized problem for a thread turn that could not start."
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false,
                  "description": "Stable hold. Editing, observation and readiness restoration never rearm it; inspect the predecessor result and clear before an ordinary continuation."
                },
                {
                  "type": "null"
                }
              ],
              "description": "Stable hold. Editing, observation and readiness restoration never rearm it; inspect the predecessor result and clear before an ordinary continuation."
            },
            "dispatchedRevision": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ControlRunControlResponse/properties/deferredMessage/properties/revision"
                },
                {
                  "type": "null"
                }
              ]
            },
            "successorJobId": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ControlRunControlResponse/properties/runId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Non-empty identifier string."
            },
            "successorRunId": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ControlRunControlResponse/properties/runId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Non-empty identifier string."
            }
          },
          "required": [
            "draftId",
            "revision",
            "state",
            "predecessorJobId",
            "predecessorRunId",
            "predecessorResult",
            "hold",
            "dispatchedRevision",
            "successorJobId",
            "successorRunId"
          ],
          "additionalProperties": false,
          "description": "The run's latest next-message draft after this cancel: a waiting draft is held by the same call; an already accepted successor is named, not cancelled."
        }
      },
      "required": [
        "accepted"
      ],
      "additionalProperties": false,
      "description": "Response to a run control request."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
