{
  "$ref": "#/definitions/HarnessEvent",
  "definitions": {
    "HarnessEvent": {
      "type": "object",
      "properties": {
        "request_refusal": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "scope": {
                  "type": "string",
                  "const": "turn_text",
                  "description": "All text input items in one native turn; separate instructions are excluded."
                },
                "unit": {
                  "type": "string",
                  "const": "unicode_scalars"
                },
                "limit": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "const": "input_too_large"
                },
                "actual": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "native_code": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "scope",
                "unit",
                "limit",
                "source",
                "kind",
                "actual",
                "native_code"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "vendor_cli_too_old"
                },
                "native_code": {
                  "type": "string",
                  "const": "claude_code_version_too_old"
                },
                "source": {
                  "type": "string",
                  "const": "claude_stdout"
                },
                "binary_path": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "installed_version": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "native_code",
                "source",
                "binary_path",
                "installed_version"
              ],
              "additionalProperties": false
            }
          ],
          "description": "Vendor-attested request refusal that another account cannot repair; input and executable causes carry their own evidence."
        },
        "effort_resolution": {
          "type": "object",
          "properties": {
            "requested": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "description": "User-supplied string that must contain visible content, not just whitespace."
                },
                {
                  "type": "null"
                }
              ],
              "description": "Original effort preference before adaptation; null when none was requested."
            },
            "submitted": {
              "anyOf": [
                {
                  "$ref": "#/definitions/HarnessEvent/properties/effort_resolution/properties/requested/anyOf/0"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native option prepared for transport; null means omitted, never the explicit token none. Not proof of dispatch."
            },
            "resolution": {
              "type": "string",
              "enum": [
                "exact",
                "downward",
                "floor",
                "omitted",
                "unverifiable",
                "rejected"
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "account_catalog",
                "live_probe",
                "versioned_snapshot",
                "adapter"
              ]
            },
            "parameter": {
              "anyOf": [
                {
                  "$ref": "#/definitions/HarnessEvent/properties/effort_resolution/properties/requested/anyOf/0"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native carrier, such as reasoning.effort, model_reasoning_effort or --effort; null when no separate knob is carried."
            },
            "observed": {
              "anyOf": [
                {
                  "$ref": "#/definitions/HarnessEvent/properties/effort_resolution/properties/requested/anyOf/0"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Provider-reported effort only; null when unobserved, never copied from submission."
            },
            "observedSource": {
              "anyOf": [
                {
                  "$ref": "#/definitions/HarnessEvent/properties/effort_resolution/properties/requested/anyOf/0"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Provider event/field that reported observed effort; null when unobserved."
            },
            "reason": {
              "$ref": "#/definitions/HarnessEvent/properties/effort_resolution/properties/requested/anyOf/0",
              "description": "Diagnostic explanation; consumers branch on resolution, never prose."
            }
          },
          "required": [
            "requested",
            "submitted",
            "resolution",
            "source",
            "parameter",
            "observed",
            "observedSource"
          ],
          "additionalProperties": false
        },
        "processing": {
          "type": "object",
          "properties": {
            "requested": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "standard",
                    "fast",
                    "economy"
                  ],
                  "description": "Advisory service preference. Fast or Economy may use ordinary Standard service; fallback never introduces Fast. Omission preserves native defaults. Explicit native serviceTier takes precedence."
                },
                {
                  "type": "null"
                }
              ],
              "description": "Advisory service preference. Fast or Economy may use ordinary Standard service; fallback never introduces Fast. Omission preserves native defaults. Explicit native serviceTier takes precedence."
            },
            "submitted": {
              "anyOf": [
                {
                  "$ref": "#/definitions/HarnessEvent/properties/processing/properties/requested/anyOf/0"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Advisory service preference. Fast or Economy may use ordinary Standard service; fallback never introduces Fast. Omission preserves native defaults. Explicit native serviceTier takes precedence."
            },
            "submittedNative": {
              "anyOf": [
                {
                  "$ref": "#/definitions/HarnessEvent/properties/effort_resolution/properties/requested/anyOf/0"
                },
                {
                  "type": "null"
                }
              ],
              "description": "User-supplied string that must contain visible content, not just whitespace."
            },
            "observed": {
              "type": "string",
              "enum": [
                "standard",
                "fast",
                "economy",
                "mixed",
                "unknown"
              ]
            },
            "observedNative": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/HarnessEvent/properties/effort_resolution/properties/requested/anyOf/0"
              }
            },
            "reason": {
              "anyOf": [
                {
                  "$ref": "#/definitions/HarnessEvent/properties/effort_resolution/properties/requested/anyOf/0"
                },
                {
                  "type": "null"
                }
              ],
              "description": "User-supplied string that must contain visible content, not just whitespace."
            },
            "source": {
              "$ref": "#/definitions/HarnessEvent/properties/effort_resolution/properties/requested/anyOf/0"
            }
          },
          "required": [
            "requested",
            "submitted",
            "submittedNative",
            "observed",
            "observedNative",
            "reason",
            "source"
          ],
          "additionalProperties": false,
          "description": "Requested intent, submitted native control, and observed execution are independent facts. A submitted flag never proves observed service; mixed or missing session observations remain explicit."
        },
        "processing_cost_basis": {
          "type": "object",
          "properties": {
            "nativeMode": {
              "anyOf": [
                {
                  "$ref": "#/definitions/HarnessEvent/properties/effort_resolution/properties/requested/anyOf/0"
                },
                {
                  "type": "null"
                }
              ],
              "description": "User-supplied string that must contain visible content, not just whitespace."
            },
            "kind": {
              "type": "string",
              "enum": [
                "included",
                "paid_credits",
                "cash",
                "valuation",
                "unknown"
              ]
            },
            "source": {
              "$ref": "#/definitions/HarnessEvent/properties/effort_resolution/properties/requested/anyOf/0"
            }
          },
          "required": [
            "nativeMode",
            "kind",
            "source"
          ],
          "additionalProperties": false,
          "description": "Mode-qualified billing evidence for an existing cost record. Authentication alone does not establish included premium service; credits, cash, and token valuation stay distinct."
        },
        "type": {
          "type": "string",
          "enum": [
            "started",
            "thinking",
            "message",
            "tool_call",
            "tool_result",
            "interaction_requested",
            "file_change",
            "patch_produced",
            "usage",
            "error",
            "status",
            "context",
            "completed"
          ],
          "description": "Normalized event type covering session lifecycle, output, tool use, interaction, file changes, usage, transient status, context-management signals, and errors."
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "description": "Session the event belongs to."
        },
        "ts": {
          "type": "string",
          "description": "Event timestamp."
        },
        "text": {
          "type": "string",
          "description": "Text content for thinking/message/error events."
        },
        "final": {
          "type": "boolean",
          "description": "True on the harness's typed final-answer message (vendor terminal result); mid-run narration never sets it."
        },
        "tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Native tool name as the harness reports it."
            },
            "kind": {
              "type": "string",
              "enum": [
                "web",
                "file",
                "command",
                "mcp",
                "search",
                "other"
              ],
              "description": "Coarse tool classification used for typed governance; adapters map native tool names to a kind.",
              "default": "other"
            },
            "use_id": {
              "type": "string",
              "description": "Correlates a tool_result with its tool_call."
            },
            "target": {
              "type": "string",
              "description": "Redacted, bounded human-readable target (query/url/path/command)."
            },
            "status": {
              "type": "string",
              "enum": [
                "ok",
                "error",
                "cancelled",
                "denied"
              ],
              "description": "Outcome of the tool use; required on tool_result events (a missing status is never treated as ok)."
            },
            "error_summary": {
              "type": "string",
              "description": "Redacted, bounded error detail for status=error results."
            },
            "content_summary": {
              "type": "string",
              "description": "Redacted, bounded content detail for results (success or failure)."
            },
            "exit_code": {
              "type": "integer",
              "description": "Process exit code for command tools, when known."
            },
            "web_retrieval": {
              "type": "string",
              "enum": [
                "verified",
                "dispatched",
                "failed"
              ],
              "description": "Adapter-stamped web/browser retrieval outcome (verified/dispatched/failed), distinct from the tool-call status lifecycle."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "description": "Typed tool info; set on tool_call and tool_result events."
        },
        "interaction": {
          "type": "object",
          "properties": {
            "interaction_id": {
              "type": "string",
              "minLength": 1,
              "description": "Interaction id used to correlate the answer set."
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Question id."
                  },
                  "question": {
                    "type": "string",
                    "description": "The question text."
                  },
                  "header": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "default": null,
                    "description": "Short chip/header text some harnesses attach to a question."
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "description": "Option label shown to the user."
                        },
                        "description": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "default": null,
                          "description": "Optional longer explanation of the option."
                        }
                      },
                      "required": [
                        "label"
                      ],
                      "additionalProperties": false,
                      "description": "One multiple-choice option of an interactive question."
                    },
                    "default": [],
                    "description": "Selectable options; empty for free-text-only questions."
                  },
                  "multi_select": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether multiple options may be selected."
                  }
                },
                "required": [
                  "id",
                  "question"
                ],
                "additionalProperties": false,
                "description": "One question of an interactive user-input request."
              },
              "default": [],
              "description": "Questions the harness wants answered."
            },
            "source_tool": {
              "type": [
                "string",
                "null"
              ],
              "default": null,
              "description": "Native tool that raised the request (e.g. \"AskUserQuestion\")."
            }
          },
          "required": [
            "interaction_id"
          ],
          "additionalProperties": false,
          "description": "Set on interaction_requested events."
        },
        "patch_envelope": {
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "number",
              "const": 1
            },
            "context_packet_hash": {
              "type": "string",
              "minLength": 1,
              "description": "Content hash in algo:hex form, e.g. \"sha256:abcd...\"."
            },
            "base_tree_sha": {
              "type": "string",
              "minLength": 1
            },
            "patch": {
              "type": "string",
              "minLength": 1
            },
            "patch_hash": {
              "$ref": "#/definitions/HarnessEvent/properties/patch_envelope/properties/context_packet_hash"
            },
            "touched_paths": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expected_blob_oid": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Base-tree blob oid, or null only when the path is absent in the base tree."
                  }
                },
                "required": [
                  "path",
                  "expected_blob_oid"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "schema_version",
            "context_packet_hash",
            "base_tree_sha",
            "patch",
            "patch_hash",
            "touched_paths"
          ],
          "additionalProperties": false,
          "description": "Typed hash-bound patch produced by a git-patch-envelope harness."
        },
        "refusal_code": {
          "type": "string",
          "enum": [
            "raw_patch_requires_isolation",
            "raw_patch_missing_evidence",
            "raw_patch_digest_mismatch",
            "raw_patch_base_mismatch",
            "raw_patch_path_traversal",
            "raw_patch_outside_scope",
            "raw_patch_stale_preimage",
            "raw_patch_binary_unsupported",
            "raw_patch_truncated",
            "raw_patch_apply_failed"
          ],
          "description": "Typed refusal code for a rejected raw patch contract."
        },
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Input tokens consumed."
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Output tokens produced."
            },
            "cached_input_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Reported cache token count; relation to input_tokens is harness-specific."
            },
            "input_token_usage": {
              "type": "object",
              "properties": {
                "total_tokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cache_read_tokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cache_write_tokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "total_tokens",
                "cache_read_tokens",
                "cache_write_tokens"
              ],
              "additionalProperties": false,
              "description": "Complete reported input total, including cache reads/writes, and its separately measured cache subsets. Null means unknown, never zero or a partial sum."
            },
            "cost_usd": {
              "type": "number",
              "minimum": 0,
              "description": "Cost in USD."
            },
            "cost_basis": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "cash",
                    "valuation",
                    "unknown"
                  ]
                },
                "source": {
                  "$ref": "#/definitions/HarnessEvent/properties/effort_resolution/properties/requested/anyOf/0"
                }
              },
              "required": [
                "kind",
                "source"
              ],
              "additionalProperties": false,
              "description": "Observed meaning of this usage.cost_usd amount, separate from prospective processing billing. List-price valuation is not a cash or credit debit receipt. Native paid-credit consumption remains unknown when the vendor exposes no amount evidence."
            },
            "estimated": {
              "type": "boolean",
              "description": "True when cost_usd is derived from token pricing (not natively reported)."
            }
          },
          "additionalProperties": false,
          "description": "Token/cost usage reported by the harness."
        },
        "observed_model": {
          "type": "string",
          "description": "Model the harness actually reported using."
        },
        "credential_route": {
          "type": "string",
          "enum": [
            "vendor_native",
            "managed_api_key",
            "local"
          ],
          "description": "Concrete credential route selected before spawn; first-class route evidence, never inferred from free-form payload text."
        },
        "credential_source": {
          "type": "string",
          "enum": [
            "native_session",
            "oauth_token_env",
            "api_key_env",
            "api_key_flag",
            "provider_auth_file",
            "none"
          ],
          "description": "Concrete credential source selected before spawn; exact native subscription requires native_session, never an OAuth token or API key."
        },
        "credential_profile_id": {
          "type": "string",
          "minLength": 1,
          "description": "Credential profile the attempt runs under; absent = engine-default credentials (INV-135 attribution)."
        },
        "account_usage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "code",
              "detail"
            ],
            "additionalProperties": false
          },
          "description": "Native informational overage diagnostics translated by the adapter; never inference admission authority."
        },
        "quota": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "codex_app_server",
                "codex_rollout",
                "claude_statusline",
                "claude_api_retry",
                "claude_oauth_usage",
                "agy_command_usage",
                "cursor_rate_limit",
                "claude_rate_limit_event",
                "codex_app_server_event",
                "codex_image_response"
              ],
              "description": "Machine-readable source of quota evidence, classified by schema-owned traits."
            },
            "plan_label": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "subject_id": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/HarnessEvent/properties/credential_profile_id"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "applies_to_models": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "$ref": "#/definitions/HarnessEvent/properties/credential_profile_id"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "applies_to_model_prefixes": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/HarnessEvent/properties/credential_profile_id"
                    }
                  },
                  "applies_to_unspecified_model": {
                    "type": "boolean"
                  },
                  "applies_to_request_kinds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "text",
                        "image"
                      ]
                    },
                    "minItems": 1,
                    "description": "Vendor-declared operation scope. Absent applies to both text and image; model scope still applies independently."
                  },
                  "used_ratio": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "window_seconds": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "resets_at": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cooldown_until": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  }
                },
                "required": [
                  "id",
                  "label",
                  "used_ratio",
                  "window_seconds",
                  "resets_at"
                ],
                "additionalProperties": false,
                "description": "One independent vendor quota window; without model ids or declared prefixes it applies to every model, and null usage stays unknown."
              }
            }
          },
          "required": [
            "source",
            "constraints"
          ],
          "additionalProperties": false,
          "description": "All quota windows from a vendor-owned machine-readable source; never scraped from prose or collapsed into a fake aggregate."
        },
        "plan_progress": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Plan item id."
                  },
                  "title": {
                    "type": "string",
                    "description": "Plan item title."
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "in_progress",
                      "completed"
                    ],
                    "description": "Progress state of the item."
                  }
                },
                "required": [
                  "id",
                  "title",
                  "status"
                ],
                "additionalProperties": false
              },
              "default": [],
              "description": "Last-wins list of plan/todo items."
            }
          },
          "additionalProperties": false,
          "description": "Typed live plan/todo progress mapped from the harness's native plan tools, never parsed from prose."
        },
        "rate_limit": {
          "type": "object",
          "properties": {
            "constraint_id": {
              "$ref": "#/definitions/HarnessEvent/properties/credential_profile_id",
              "description": "Vendor-owned rate-window identity, when the adapter can map it from a typed field."
            },
            "applies_to_request_kinds": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/HarnessEvent/properties/quota/properties/constraints/items/properties/applies_to_request_kinds/items"
              },
              "minItems": 1
            },
            "applies_to_models": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/HarnessEvent/properties/credential_profile_id"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Canonical model ids/aliases this rejection applies to; omitted/null means every model."
            },
            "resets_at": {
              "type": [
                "string",
                "null"
              ],
              "default": null,
              "description": "When the rate window resets, when reported."
            },
            "retry_delay_ms": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Suggested retry delay in milliseconds, when reported."
            }
          },
          "additionalProperties": false,
          "description": "Typed rate-limit/quota signal set by the adapter when the native CLI reports a 429/quota/overload."
        },
        "status": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "api_retry"
              ],
              "description": "Kind of transient status."
            },
            "attempt": {
              "type": "integer",
              "minimum": 0,
              "description": "Retry attempt number."
            },
            "max_retries": {
              "type": "integer",
              "minimum": 0,
              "description": "Vendor's configured retry ceiling."
            },
            "retry_delay_ms": {
              "type": "integer",
              "minimum": 0,
              "description": "Delay before the retry, when reported."
            },
            "error_category": {
              "type": "string",
              "enum": [
                "authentication_failed",
                "oauth_org_not_allowed",
                "billing_error",
                "rate_limit",
                "overloaded",
                "invalid_request",
                "model_not_found",
                "server_error",
                "max_output_tokens",
                "timeout",
                "unknown"
              ],
              "description": "Vendor error category mapped onto the normalized enum; unrecognized values collapse to 'unknown' (never free-form prose)."
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "description": "Typed transient-status detail set by the adapter on status events."
        },
        "transient": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "network",
                "stream_disconnect",
                "service_unavailable",
                "timeout",
                "unknown"
              ],
              "default": "unknown",
              "description": "Kind of transient failure."
            },
            "retry_delay_ms": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Suggested retry delay in milliseconds, when reported."
            }
          },
          "additionalProperties": false,
          "description": "Typed transient-failure signal set by the adapter from native CLI/API error shapes, consumed for bounded retry policy."
        },
        "context": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "compaction_started",
                "compaction_completed",
                "capacity_exhausted"
              ],
              "description": "Kind of context signal: a compaction boundary starting/completing, or terminal capacity exhaustion."
            },
            "cause": {
              "type": "string",
              "enum": [
                "prompt_too_long",
                "repeated_refill",
                "blocking_limit",
                "window_exceeded",
                "unknown"
              ],
              "default": "unknown",
              "description": "Why the context signal fired, mapped onto a typed cause (never prose)."
            },
            "native_code": {
              "type": [
                "string",
                "null"
              ],
              "default": null,
              "description": "The vendor's own terminal/context code passed verbatim as evidence; null when none."
            },
            "trigger": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "manual",
                    "auto"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Whether the compaction was manually or automatically triggered; null when unreported."
            },
            "pre_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Token count before the compaction/exhaustion, when the vendor reports it; null otherwise."
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "description": "Typed context-management signal (compaction boundary / capacity exhaustion) set by the adapter; orthogonal to the transient-retry taxonomy."
        },
        "error": {
          "type": "string",
          "description": "Error text for error events."
        },
        "aborted": {
          "type": "boolean",
          "description": "Typed terminal cancellation marker, set on completed events when the run was aborted."
        },
        "payload": {
          "type": "object",
          "additionalProperties": {},
          "description": "Raw adapter-specific payload for diagnostics."
        }
      },
      "required": [
        "type",
        "session_id",
        "ts"
      ],
      "additionalProperties": false,
      "description": "Normalized event emitted by every adapter (the SSOT of adapter output)."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
